# Any OpenAI-compatible chat endpoint (OpenAI, vLLM, Ollama, LiteLLM, OpenRouter, ...).
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL are accepted as fallbacks.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0

# Embeddings for semantic search. "local" runs a small ONNX model on CPU (no API needed).
# Set EMBEDDING_PROVIDER=openai to use an OpenAI-compatible /embeddings route instead;
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY default to the LLM settings above.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# SWGOH_DATA_DIR=./data
